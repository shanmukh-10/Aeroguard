# AeroGuard Environment Configuration Example
# Copy to .env and configure local variables

# Database connection URL (PostgreSQL default or SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aeroguard

# Server settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# External API integrations (Optional)
WEATHER_API_KEY=
MAP_API_KEY=
